# Config do Firebase (Fase 2). Copie para .env e preencha com os valores do
# console do Firebase (Project settings > General > Your apps > Web).
# O .env NAO vai para o git (ver .gitignore).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Sync com a planilha (Apps Script) — Fase 2 / Parte 3
# URL do "app da web" do Apps Script e o mesmo SEGREDO que voce definiu no Codigo.gs
VITE_SHEET_SYNC_URL=
VITE_SHEET_SYNC_SECRET=
